# Web app settings (chat UI, agent, monitor). See DEPLOYMENT.md section 6.

OTEL_SERVICE_NAME=oracle-dba-agent

# OpenAI-compatible LLM endpoint (OpenWebUI, LiteLLM, vLLM, a gateway...).
# The model must support tool calling.
OPENWEBUI_BASE_URL=https://llm.example.com/api
OPENWEBUI_MODELS_URL=https://llm.example.com/api/models
OPENWEBUI_API_KEY=
LLM_MODEL=

# CA bundle for HTTPS to the LLM endpoint, if it uses a corporate CA.
SSL_CERT_FILE=

# Where the agent finds the MCP server (same host, loopback).
MCP_SERVER_URL=http://127.0.0.1:9000/mcp

# Keep routine web routes out of traces.
OTEL_PYTHON_STARLETTE_EXCLUDED_URLS=metrics,api/health,api/configure,favicon.ico

# Monitor. Poll interval in seconds (lower = faster detection, more DB and
# LLM activity). Thresholds: tune to each database's normal load.
MONITOR_POLL_INTERVAL_SECONDS=15
MONITOR_TABLESPACE_WARN_PCT=85
MONITOR_TABLESPACE_CRIT_PCT=95
MONITOR_LONG_RUNNING_QUERY_SECONDS=60
MONITOR_WRITE_WARN_COMMITS_PER_SEC=20
MONITOR_WRITE_CRIT_COMMITS_PER_SEC=100
MONITOR_WRITE_WARN_REDO_MB_PER_SEC=2
MONITOR_WRITE_CRIT_REDO_MB_PER_SEC=15
MONITOR_WRITE_WARN_EXECUTES_PER_SEC=1000
MONITOR_WRITE_CRIT_EXECUTES_PER_SEC=7000
# Optional cheaper model for monitor recommendations (empty = LLM_MODEL).
MONITOR_LLM_MODEL=
# Incident and approval-audit database.
MONITOR_SQLITE_PATH=./monitor.db
