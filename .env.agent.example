# Agent telemetry identity
OTEL_SERVICE_NAME=oracle-dba-agent

# OpenWebUI (OpenAI-compatible endpoint)
LLM_MODEL=qwen3:8b
OPENWEBUI_BASE_URL=http://localhost:3000/api
OPENWEBUI_MODELS_URL=http://localhost:3000/api/models
OPENWEBUI_API_KEY=

# Corporate CA certificate (leave blank if not needed)
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# MCP server used by the agent
MCP_SERVER_URL=http://localhost:9000/mcp

# Suppress noisy web routes from tracing
OTEL_PYTHON_STARLETTE_EXCLUDED_URLS=metrics,api/health,api/configure,favicon.ico

# Model provider selection
LLM_PROVIDER=openwebui

# Whether the agent requires strict tool-schema behavior
OPENWEBUI_STRICT_TOOLS=false

# Agent web/API server
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000

# Agent audit logging
AUDIT_LOG_DIR=logs
AUDIT_LOG_FINAL_ANSWER=false

# Monitor polling interval in seconds.
# Controls how often the background monitor checks Oracle for new,
# continuing, resolved, or reopened incidents.
# Default: 60 seconds.
# Lower values detect changes faster but increase database and LLM activity.
MONITOR_POLL_INTERVAL_SECONDS=15

MONITOR_WRITE_WARN_COMMITS_PER_SEC=20
MONITOR_WRITE_CRIT_COMMITS_PER_SEC=100

MONITOR_WRITE_WARN_REDO_MB_PER_SEC=2
MONITOR_WRITE_CRIT_REDO_MB_PER_SEC=15

MONITOR_WRITE_WARN_EXECUTES_PER_SEC=1000
MONITOR_WRITE_CRIT_EXECUTES_PER_SEC=7000
