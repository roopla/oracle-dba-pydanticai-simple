# Lab scenarios and load simulators (scripts/scenarios.py and the
# simulators it drives). See SCENARIOS.md. Load this file after .env.mcp.

# They degrade the database on purpose: set true ONLY for a lab or test
# database. Every scenario refuses to run while this is false.
LAB_SCENARIOS_ENABLED=false

# The load schema. `scenarios.py prepare` creates it with this password.
# The user name is optional (default LOADGEN).
LOADGEN_ORACLE_USER=LOADGEN
LOADGEN_ORACLE_PASSWORD=

# DBA login for scenario setup: creating the load schema and demo
# tablespaces, and ALTER SYSTEM log switches. Needed when ORACLE_USER in
# .env.mcp is the least-privilege agent account.
SCENARIO_ADMIN_USER=
SCENARIO_ADMIN_PASSWORD=
