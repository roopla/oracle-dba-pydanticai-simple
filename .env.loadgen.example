# Load AFTER .env.mcp so these override ORACLE_USER.
# Host, port, domain and default PDB still come from .env.mcp.
LOADGEN_ORACLE_USER=LOADGEN
LOADGEN_ORACLE_PASSWORD=

# Lab scenarios (scripts/scenarios.py, scripts/*_simulator.py). They degrade
# the database on purpose: set true ONLY for a lab or test database.
LAB_SCENARIOS_ENABLED=false
# DBA login for scenario setup (create users/tablespaces, log switches).
# Leave empty to use ORACLE_USER / ORACLE_PASSWORD from .env.mcp.
SCENARIO_ADMIN_USER=
SCENARIO_ADMIN_PASSWORD=
