# Database settings, read by BOTH processes (MCP server and web app).
# See DEPLOYMENT.md section 6 for every setting.

OTEL_SERVICE_NAME=oracle-dba-mcp

# Primary database listener
ORACLE_HOST=dbhost.example.com
ORACLE_PORT=1521

# The agent's account: the least-privilege common user from DEPLOYMENT.md 4.1
ORACLE_USER=C##DBA_AGENT
ORACLE_PASSWORD=

# Service names are <name>[.<ORACLE_DOMAIN>]. Leave ORACLE_DOMAIN empty
# when your services have no domain (check with: lsnrctl services).
ORACLE_DOMAIN=
ORACLE_CDB_NAME=CDB1
ORACLE_DEFAULT_PDB_NAME=PDB1

# MCP server address. It has no authentication: keep it on loopback unless
# a firewall limits who can reach it.
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_PATH=/mcp

# Data Guard standby (optional). Full address of a service that reaches the
# MOUNTED standby, e.g. stbyhost.example.com:1521/CDB1_STBY, and a SYSDBA
# login. Leave empty when there is no standby.
ORACLE_STANDBY_DSN=
ORACLE_STANDBY_USER=sys
ORACLE_STANDBY_PASSWORD=

# restart_standby_instance only (optional). It runs SQL*Plus through
# `docker exec` on the standby host over SSH, so it applies only when the
# standby is a Docker container. Leave all empty otherwise: the action is
# then never offered. The host key must already be in ~/.ssh/known_hosts.
STANDBY_SSH_HOST=
STANDBY_SSH_PORT=22
STANDBY_SSH_USER=
STANDBY_SSH_PASSWORD=
STANDBY_SSH_KEY_FILE=
STANDBY_CONTAINER=
