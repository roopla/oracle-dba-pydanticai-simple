# MCP telemetry identity
OTEL_SERVICE_NAME=oracle-dba-mcp

# Oracle connection
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=system
ORACLE_PASSWORD=

# Oracle service construction
ORACLE_DOMAIN=localdomain
ORACLE_CDB_NAME=ORCLCDB
ORACLE_DEFAULT_PDB_NAME=ORCLPDB1

# MCP server transport
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_PATH=/mcp

# Oracle/database diagnostic logging
DB_DEBUG=false

# Data Guard standby (SYSDBA connection to a mounted standby)
ORACLE_STANDBY_DSN=172.23.0.3:1521/ORCLCDB_STBY.localdomain
ORACLE_STANDBY_USER=sys
ORACLE_STANDBY_PASSWORD=
