# MCP telemetry identity
OTEL_SERVICE_NAME=oracle-dba-mcp

# Oracle connection
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=system
ORACLE_PASSWORD=

# Oracle service construction
ORACLE_DOMAIN=localdomain
ORACLE_CDB_NAME=ORCLCDB
ORACLE_DEFAULT_PDB_NAME=ORCLPDB1

# MCP server transport
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_PATH=/mcp

# Oracle/database diagnostic logging
DB_DEBUG=false

# Data Guard standby (SYSDBA connection to a mounted standby)
ORACLE_STANDBY_DSN=172.23.0.3:1521/ORCLCDB_STBY.localdomain
ORACLE_STANDBY_USER=sys
ORACLE_STANDBY_PASSWORD=

# Standby instance control for restart_standby_instance.
# Thin-mode python-oracledb cannot SHUTDOWN/STARTUP, so those run as
# SQL*Plus inside the standby's Docker container over SSH. The host key
# must already be in ~/.ssh/known_hosts. Prefer a key file over a password.
STANDBY_SSH_HOST=192.168.56.30
STANDBY_SSH_PORT=22
STANDBY_SSH_USER=alpoor
STANDBY_SSH_PASSWORD=
STANDBY_SSH_KEY_FILE=
STANDBY_CONTAINER=oracle19c-stby
