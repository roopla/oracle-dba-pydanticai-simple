# Tracing (optional). Without a collector, start the processes without
# --env-file .env.otel and without opentelemetry-instrument.

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.example.com:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=always_on
OTEL_PROPAGATORS=tracecontext,baggage

# true puts prompts, tool results (query data) and answers into traces.
# Keep false unless the trace store is approved for that content.
PYDANTIC_AI_INCLUDE_CONTENT=false
